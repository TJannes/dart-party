{
  "name": "dart-party",
  "productName": "Dart Party",
  "version": "0.4.0",
  "description": "An evening of randomly drawn darts mini-games around one board. Unofficial, not affiliated with Autodarts.",
  "license": "MIT",
  "author": "Tom Jannes",
  "homepage": "https://github.com/TJannes/dart-party",
  "repository": {
    "type": "git",
    "url": "https://github.com/TJannes/dart-party.git"
  },
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
